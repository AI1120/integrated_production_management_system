# Copy to backend/.env and edit. All settings use the IPMS_ prefix.

# Generate a real one for anything beyond a local demo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IPMS_SECRET_KEY=change-me

# SQLite for the sample plant; PostgreSQL for a real deployment.
# IPMS_DATABASE_URL=postgresql+psycopg://ipms:password@localhost:5432/ipms

IPMS_PLANT_CODE=PLANT-01
IPMS_PLANT_NAME=Sample Assembly Factory

# IPMS_ACCESS_TOKEN_EXPIRE_MINUTES=720
# IPMS_SQL_ECHO=false
